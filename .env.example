TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
CHAT_ID=123456789
# Comma-separated Telegram user IDs allowed to control the bot.
# REQUIRED for security: the bot runs `claude --dangerously-skip-permissions`,
# so anyone who can send messages can run arbitrary code on the host.
# Without this set, only chat-id is enforced — anyone added to the group has shell.
ALLOWED_USERS=123456789,987654321
